%! Aacurat_sqrt.ps
%% treballa fent l'arrel quadrada d'un nombre real dins una array o dins una string, amb la sintaxi [[false # #][# #]] o (#.##)
%% per retornar-ne el resultat també o dins d'una array (false) o dins d'una string (true) similar a sqrt
%% posarem un gatell per decidir si el nombre a computar i el seu resultat és array (false) o string (true)
%% la dimensió del nombre real a fer l'arrel, només està restringida per les Implementation Limits del GS
%% els límits els trobem en el nombre màxim d'elements a l'stack (800) o dins les arrays/strings (uns 16 milions)
%% vegeu la darrera versió de l'intèrpret gs... https://www.ghostscript.com/doc/current/Language.htm#Implementation_limits
%% sintaxi: [[true 1 2 1][1 2 1]] false false Aacurat_sqrt /  (121.121) true true Aacurat_sqrt
%% gs -q -dNOSAFER -o out.pdf -sDEVICE=pdfwrite -c .setpdfwrite -f Aacurat_sqrt.ps

%% escrivim l'algorisme en base a aquesta deducció aritmètica que permet tot luxe de decimals
%% https://www.wikihow.com/Calculate-a-Square-Root-by-Hand#/Image:Calculate-a-Square-Root-by-Hand-Step-6-Version-5.jpg

/Aacurat_sqrt
{
 /dona exch def  %% true treballem strings de sortida / false treballem arrays de sortida
 /Aa exch def  %% true treballem amb strings d'entrada / false treballem amb arrays d'entrada
 /dgt 1 string def 

 dup  %% el nombre a fer l'arrel
%%Aa
 Aa  %% true treballem amb strings / false treballem amb arrays
 {  %% és una string
  dup type /stringtype eq  %% ens assegurem que el gatell vs sintaxi s'adiuen
  {
   1 index type /stringtype ne  %% ens assegurem que el gatell vs sintaxi s'adiuen
   {
    (\n\n >>> aquest flag necessita treballar amb strings ...pleguem!\n\n)print flush quit
   }if
  }
  {
   (\n\n >>> aquest flag necessita treballar amb strings ...pleguem!\n\n)print flush quit
  }ifelse
  cvx exec  %% la xifra ve dins una string
  0 lt  %% és un nombre negatiu?
  {
   true  %% signe -
   /rSigne true def  %% capturem el signe
  }
  {  %% tret que sigui un fals positiu d'un zero negatiu (-0) (-0.00)
   dup 0 get 45 eq  %% se suposa que el signe menys serà l'ascii habitual
   %% false signe +
   %% true signe -
   dup /rSigne exch def  %% capturem el signe
  }ifelse
  rSigne
  {  %% no permetrem fer arrels quadrades de nombres negatius?
   (\n\n >>> no podem fer l'arrel quadrada d'un nombre negatiu perquè el resultat seria un nombre imaginari ...pleguem!\n\n)
   print flush quit
  }if
  exch
  (.) search
  %% fragmentem la part entera
  {
   exch pop  %% eliminem el punt decimal
  }
  {  %% afegim la part decimal a zero que no duu
   (0) exch
  }ifelse
  mark exch  %% balisa de l'array d'enters
  4 -1 roll exch  %% posem el signe al seu lloc
  1 index  %% si és negatiu eliminem el signe de l'string
  {
   dup length 1 sub 1 exch getinterval
  }if
  %% /dgt 1 string def 
  {  %% forall per fragmentar dígit a dígit els enters
   dgt exch 0 exch put dgt cvx exec
  }forall
  ]  %% tanquem l'array d'enters
 }
 {  %% és una array i traiem l'array d'enters
  dup type /arraytype eq  %% ens assegurem que el gatell vs sintaxi s'adiuen
  {
   1 index type /arraytype ne  %% ens assegurem que el gatell vs sintaxi s'adiuen
   {
    (\n\n >>> aquest flag necessita treballar amb arrays ...pleguem!\n\n)print flush quit
   }if
  }
  {
   (\n\n >>> aquest flag necessita treballar amb arrays ...pleguem!\n\n)print flush quit
  }ifelse
  0 get
  dup 0 get  %% capturem el signe
  {  %% signe negatiu
   /rSigne true def
   rSigne
   {  %% no permetrem fer arrels quadrades de nombres negatius?
    (\n\n >>> no podem fer l'arrel quadrada d'un nombre negatiu perquè el resultat seria un nombre imaginari ...pleguem!\n\n)
    print flush quit
   }if
  }
  {  %% signe positiu
   /rSigne false def
  }ifelse 
 }ifelse

 %% esporguem zeros a l'esquerra a l'array d'enters
 /ZE 0 def  %% nombre zeros a l'esquerra a esporgar
 dup length dup 1 sub /finS exch def 2 gt
 {  %% només si hi ha més de 2 elements (signe i un dígit) té possibilitats de contenir-ne
  1 1 finS
  {
   1 index exch get 0 eq
   {
    ZE 1 add /ZE exch def
   }
   {
    exit
   }ifelse 
  }for
  ZE 0 ne
  {  %% hi ha zeros a l'esquerra
   ZE finS eq
   {  %% l'enter és un zero
    0 get 0 2 array astore  %% refem l'array d'enters sense zeros a l'esquerra
   }
   {  %% l'enter NO és un zero
    mark exch dup 0 get exch 1 ZE add finS ZE sub getinterval aload pop ]  %% refem l'array d'enters sense zeros a l'esquerra
   }ifelse
  }if
 }if

%%Aa
 Aa  %% true treballem amb strings / false treballem amb arrays
 {
  exch mark exch
  {  %% forall per fragmentar dígit a dígit els decimals
   dgt exch 0 exch put dgt cvx exec
  }forall
 }
 {
  exch 1 get mark exch aload pop
 }ifelse

 counttomark dup /dcmls exch def 1 gt  %% sobren zeros a la dreta dels decimals?
 {  %% esporguem zeros a la dreta a l'array decimal
  /ndcmls 0 def
  {  %% loop
   dup 0 eq
   {
    pop
    ndcmls 1 add /ndcmls exch def
   }
   {
    exit
   }ifelse
  }loop
  dcmls ndcmls eq
  {  %% com que tot eren zeros, en deixem només un a l'array
   0
  }if
 }if

 ]  %% tanquem l'array decimal
 
 dup length
 dup 2 mod 0 ne  %% si els decimals són imparells hi afegim un zero a la cua
 /1z exch def
 2 index dup length 2 mod 0 eq  %% si els enters són parells
 {
  dup length 1 sub /isura exch def  %% l'índex on acaba el resultat enter (on posem la coma)
  0 0 put  %%% afegim un zero al davant de tot al lloc del signe
  3 -1 roll  %% tenim l'array d'enters a punt per repicar-la seguida
 }
 {
  length 2 sub /isura exch def  %% l'índex on acaba el resultat enter (on posem la coma)
  3 -1 roll 1 isura 1 add getinterval  %% tenim l'array d'enters a punt per repicar-la seguida
 }ifelse
 %% repiquem enters i decimals seguits dins l'string /arrelar
 exch isura 1 add add
 1z
 {
  1 add
 }if
 string /arrelar exch def  %% els dígits del nombre a fer l'arrel aparellables i seguits
 /i 0 def
 {  %% enters
  1 string cvs i exch arrelar 3 1 roll putinterval
  i 1 add /i exch def
 }forall
 {  %% decimals
  1 string cvs i exch arrelar 3 1 roll putinterval
  i 1 add /i exch def
 }forall
 1z
 {  %% un zero al final dels decimals?
  arrelar i (0) putinterval
 }if

 %% l'arrel quadrada pas a pas
 [ [rSigne ][] ] /rsltt_sqrt exch def  %% trepa inicial del resultat

%%ARA pot donar tants decimals fins que no arribem a un /limitcheck degut a la grandària dels nombres que computem
 /MAXqcnt 16 def  %% màxim nombre de dígits del resultat (enters+decimals) variable manllevada de Aacurat_div
 /sExacte false def  %% ens diu si l'arrel acaba o no de forma exacte

 /iNparell 0 def  %% index on extraure els parells
 /iEDara 0 def  %% índex sumador de dígits que ens mesura el nombre d'enters+decimals permesos
 /Arestar () def  %% enter operatiu a computar
 /Mx2 (0) def  %% cadena seguida de dígits resultants /dR que s'han de multiplicar per dos
 
 {  %% loop on encara ens cal activar el control d'un resultat enter o fins a n decimals

%%ARA pot donar tants decimals fins que no arribem a un /limitcheck degut a la grandària dels nombres que computem
%%ON HAURIEM d'activar els altres operadors de Aacurat_(add sub mul gt eq) per tal de superar aquesta limitació?
  iNparell arrelar length ge
  {  %% un cop esgotat el nombre a computar hi hem d'anar afegint parells de zeros 
%iNparell arrelar length == == iEDara ==
   arrelar length dup /araVa exch def 2 add string dup 0 arrelar putinterval dup araVa (00) putinterval /arrelar exch def
  }if

  arrelar iNparell 2 getinterval  %% nou parell a computar
  Arestar  %% enter com a cadena on hi afegim els dos dígits següents a computar
%dup ==
%%Expansiu
  dup length dup /araVa exch def 2 index length add string dup 3 -1 roll 0 exch putinterval
  dup 3 -1 roll araVa exch putinterval cvx exec
%dup ==
%%Expansiu
 /Arestar exch def  %% enter a restar

%iNparell 2 eq {(||||) Mx2(araSom)pstack quit}if
%rsltt_sqrt == % (vvvv)pstack quit

  Mx2 cvx exec 2 mul
%dup ==
%%Expansiu
 1024 string cvs  %% la cadena ha de ser tant gran com?
  dup length dup /araVa exch def 1 add string dup 3 -1 roll 0 exch putinterval dup araVa (1) putinterval
  cvx exec
%dup ==
%%Expansiu
 /mN exch def  %% màscara numèrica per trobar el /dR següent

  /dR 0 def  %% valor per defecte (resolt inicialment l'excepció a zero)

  1 1 9
  {  %% for per la màscara numèrica
   dup  %% pot ser el /dR següent
   mN mul
%dup ==
%%Expansiu
   %% dup
   Arestar gt
   {
    %% pop
    /dantes exch def
    dR  %% és el següent dígit del resultat

    dup 1 string cvs Mx2 dup length dup /araVa exch def 1 add string dup 3 -1 roll 0 exch putinterval
    dup 3 -1 roll araVa exch putinterval /Mx2 exch def  %% alimentem la cadena seguida de dígits resultants a multiplicar per 2

    iEDara 1 add /iEDara exch def

    %% interroguem l'índex /isura per saber si el dígit va a l'array enter o decimal
    iNparell isura
%(mmmm)pstack quit
 ge
    {  %% va als decimals
     rsltt_sqrt
 1 get dup length dup /araVa exch def 1 add array dup 3 -1 roll 0 exch putinterval
     dup 3 -1 roll araVa exch put  %% posem el dígit resultant a dins l'array decimal
     rsltt_sqrt exch 1 exch
%(<<<<)pstack quit
 put  %% posem l'array decimal a lloc
     exit  %% desem la trepa i sortim
    }
    {  %% va als enters
     rsltt_sqrt
 0 get dup length dup /araVa exch def 1 add array dup 3 -1 roll 0 exch putinterval
     dup 3 -1 roll araVa exch
%(eeeeee)pstack quit
 put  %% posem el dígit resultant a dins l'array d'enters
     rsltt_sqrt exch 0 exch put  %% posem l'array d'enters a lloc
     exit  %% desem la trepa i sortim
    }ifelse

   }
   {
    %% pop
    /dR exch def
   }ifelse

   mN 1 add
%dup ==
%%Expansiu
 /mN exch def

  }for  %% per la màscara numèrica

dR 9 eq
{  %% voldrà dir que hem esgotat el 9 com a darrer dígit que més s'acosta i per tant n'és el dígit resultant
 /dantes 10 def
    dR  %% és el següent dígit del resultat

    dup 1 string cvs Mx2 dup length dup /araVa exch def 1 add string dup 3 -1 roll 0 exch putinterval
    dup 3 -1 roll araVa exch putinterval /Mx2 exch def  %% alimentem la cadena seguida de dígits resultants a multiplicar per 2

    iEDara 1 add /iEDara exch def

    %% interroguem l'índex /isura per saber si el dígit va a l'array enter o decimal
    iNparell isura
%(mmmm)pstack quit
 ge
    {  %% va als decimals
     rsltt_sqrt
 1 get dup length dup /araVa exch def 1 add array dup 3 -1 roll 0 exch putinterval
     dup 3 -1 roll araVa exch put  %% posem el dígit resultant a dins l'array decimal
     rsltt_sqrt exch 1 exch
%(<<<<)pstack quit
 put  %% posem l'array decimal a lloc
%     exit  %% desem la trepa i sortim
    }
    {  %% va als enters
     rsltt_sqrt
 0 get dup length dup /araVa exch def 1 add array dup 3 -1 roll 0 exch putinterval
     dup 3 -1 roll araVa exch
%(eeeeee)pstack quit
 put  %% posem el dígit resultant a dins l'array d'enters
     rsltt_sqrt exch 0 exch put  %% posem l'array d'enters a lloc
%     exit  %% desem la trepa i sortim
    }ifelse
}if

  sExacte
  {  %% el resultat és exacte, si?
   iNparell 2 add arrelar length eq
   {  %% sempre que s'hagin acabat els dígits de /arrelar
    exit
   }
   {  %% no encara
    /sExacte false def  %% ens diu que l'arrel encara NO acaba de forma exacte
   }ifelse
  }if

  Arestar mN 1 sub
%dup ==
%%Expansiu
  dantes 1 sub
  mul
%dup ==
%%Expansiu
  sub
%dup ==
%%Expansiu
  dup 0 eq
  {  %% sortim doncs els resultat és exacte?
   /sExacte true def  %% ens diu que l'arrel acaba de forma exacte
  }if
  1024 string cvs /Arestar exch def  %% enter com a cadena a restar (la cadena és prou gran?)

  iNparell 2 add /iNparell exch def

  iEDara MAXqcnt eq
  {  %% sortim del loop si superem el nombre de dígits màxim establert (enters+decimals)
(...màxim de dígits establert...)==
   exit
  }if

 }loop  %% fins a un resultat enter o fins a n decimals


 %% encara hi manca la part final de com servim el resutat (array o string)?

}bind def

%[[false 1 1 2 1 ][1 2 1 0 0 0 0 0]] false false Aacurat_sqrt
%(0001121.121) true true Aacurat_sqrt
%(12345.5678901) true true Aacurat_sqrt

%(4.016016)  %% exemples de resultat exacte amb decimals
%(4.004017008016)

(35) true true Aacurat_sqrt

rsltt_sqrt
%% mN dR Mx2 dantes
(vaAdecimals)pstack quit

