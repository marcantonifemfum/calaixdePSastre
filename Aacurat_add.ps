%! Aacurat_add.ps
%% treballa sumant dos nombres reals dins dues arrays o dins dues strings, amb la sintaxi [[false # #][# #]] o (#.##)
%% per retornar-ne el resultat també o dins d'una array o dins d'una string (similar a add)
%% posarem dos gatells per decidir si els nombres a computar i el seu resultat són arrays o strings
%% les dimensions dels nombres reals a sumar, només estan restringides per les Implementation Limits del GS
%% els límits els trobem en el nombre màxim d'elements a l'stack (800) o dins les arrays/strings (uns 16 milions)
%% vegeu la darrera versió de l'intèrpret gs... https://www.ghostscript.com/doc/current/Language.htm#Implementation_limits
%% sintaxi: [[false 1][0]] [[true 1 1][0 0 1]] false false Aacurat_add /  (-11.0010000) (00011.001) true true Aacurat_add
%% gs -q -dNOSAFER -o out.pdf -sDEVICE=pdfwrite -c .setpdfwrite -f Aacurat_add.ps

/Aacurat_add
{
 /dona exch def  %% true treballem strings de sortida / false treballem arrays de sortida
 /Aa exch def  %% true treballem amb strings d'entrada / false treballem amb arrays d'entrada
 /dgt 1 string def 
 
 exch  %% el primer nombre /1nmbr
 dup
%%Aa
 Aa  %% true treballem amb strings / false treballem amb arrays
 {  %% el primer nombre /1nmbr és una string
  dup type /stringtype eq  %% ens assegurem que el gatell vs sintaxi s'adiuen
  {
   2 index type /stringtype ne  %% ens assegurem que el gatell vs sintaxi s'adiuen
   {
    (\n\n >>> aquest flag necessita treballar amb strings ...pleguem!\n\n)print flush quit
   }if
  }
  {
   (\n\n >>> aquest flag necessita treballar amb strings ...pleguem!\n\n)print flush quit
  }ifelse

%%  cvx exec  %% corríem el risc de limitcheck
  %% la xifra ve dins una string
%%  0 lt
  %% és un nombre negatiu?
  0 get 45 eq  %% se suposa que el signe menys serà l'ascii habitual
  {
   true  %% signe -
  }
  {  %% tret que sigui un fals positiu d'un zero negatiu (-0) (-0.00)
   dup 0 get 45 eq  %% se suposa que el signe menys serà l'ascii habitual
   %% false signe +
   %% true signe -
  }ifelse
  exch
  (.) search
  %% fragmentem la part entera
  {
   exch pop  %% eliminem el punt decimal
  }
  {  %% afegim la part decimal a zero que no duu
   (0) exch
  }ifelse
  mark exch  %% balisa de l'array d'enters
  4 -1 roll exch  %% posem el signe al seu lloc
  1 index  %% si és negatiu eliminem el signe de l'string
  {
   dup length 1 sub 1 exch getinterval
  }if
  %% /dgt 1 string def 
  {  %% forall per fragmentar dígit a dígit els enters
   dgt exch 0 exch put dgt cvx exec
  }forall
  ]  %% tanquem l'array d'enters
 }
 {  %% traiem l'array d'enters
  dup type /arraytype eq  %% ens assegurem que el gatell vs sintaxi s'adiuen
  {
   2 index type /arraytype ne  %% ens assegurem que el gatell vs sintaxi s'adiuen
   {
    (\n\n >>> aquest flag necessita treballar amb arrays ...pleguem!\n\n)print flush quit
   }if
  }
  {
   (\n\n >>> aquest flag necessita treballar amb arrays ...pleguem!\n\n)print flush quit
  }ifelse
  0 get
 }ifelse

 %% esporguem zeros a l'esquerra a l'array d'enters
 /ZE 0 def  %% nombre zeros a l'esquerra a esporgar
 dup length dup 1 sub /finS exch def 2 gt
 {  %% només si hi ha més de 2 elements (signe i un dígit) té possibilitats de contenir-ne
  1 1 finS
  {
   1 index exch get 0 eq
   {
    ZE 1 add /ZE exch def
   }
   {
    exit
   }ifelse 
  }for
  ZE 0 ne
  {  %% hi ha zeros a l'esquerra
   ZE finS eq
   {  %% l'enter és un zero
    0 get 0 2 array astore  %% refem l'array d'enters sense zeros a l'esquerra
   }
   {  %% l'enter NO és un zero
    mark exch dup 0 get exch 1 ZE add finS ZE sub getinterval aload pop ]  %% refem l'array d'enters sense zeros a l'esquerra
   }ifelse
  }if
 }if

%%Aa
 Aa  %% true treballem amb strings / false treballem amb arrays
 {
  exch mark exch
  {  %% forall per fragmentar dígit a dígit els decimals
   dgt exch 0 exch put dgt cvx exec
  }forall
 }
 {
  exch 1 get mark exch aload pop
 }ifelse

 counttomark dup /dcmls exch def 1 gt  %% sobren zeros a la dreta dels decimals?
 {  %% esporguem zeros a la dreta a l'array decimal
  /ndcmls 0 def
  {  %% loop
   dup 0 eq
   {
    pop
    ndcmls 1 add /ndcmls exch def
   }
   {
    exit
   }ifelse
  }loop
  dcmls ndcmls eq
  {  %% com que tot eren zeros, en deixem només un a l'array
   0
  }if
 }if

 ]  %% tanquem l'array decimal
 
 %% primer nombre fragmentat i empaquetat
 2 array astore dup /1nmbr exch def
 exch  %% /1nmbr a lloc

%%Aa
 Aa
 {
  dup
%%  cvx exec  %% corríem el risc de limitcheck
  %% la xifra ve dins una string
%%  0 lt
  %% és un nombre negatiu?
  0 get 45 eq  %% se suposa que el signe menys serà l'ascii habitual
  {
   /esN true def  %% signe -
  }
  {  %% tret que sigui un fals positiu d'un zero negatiu (-0) (-0.00)
   dup 0 get 45 eq  %% se suposa que el signe menys serà l'ascii habitual
   /esN exch def  %% false signe + / true signe -
  }ifelse
  %% capturem el nombre a computar per fragmentar-lo a dígits
  %% en realitat la part entera no caldria fragmentar-la, però això ens permetrà manegar nombres molt grans

  %% encara que sigui un enter, sempre durà un primer decimal a zero
  (.) search
  %% fragmentem la part entera
  {
   exch pop  %% eliminem el punt decimal
  }
  {  %% afegim la part decimal a zero que no duu
   (0) exch
  }ifelse
  mark exch  %% balisa de l'array d'enters
  esN  %% si és negatiu eliminem el signe de l'string
  {
   dup length 1 sub 1 exch getinterval 
  }if
  esN exch  %% l'índex 0 de l'array d'enters és el signe
  %% /dgt 1 string def 
  {  %% forall per fragmentar dígit a dígit els enters
   dgt exch 0 exch put dgt cvx exec
  }forall
  ]  %% tanquem l'array d'enters
 }
 {  %% traiem l'array d'enters de 2nmbr
  dup 0 get
 }ifelse

 %% esporguem zeros a l'esquerra a l'array d'enters
 /ZE 0 def  %% nombre zeros a l'esquerra a esporgar
 dup length dup 1 sub /finS exch def 2 gt
 {  %% només si hi ha més de 2 elements (signe i un dígit) té possibilitats de contenir-ne
  1 1 finS
  {
   1 index exch get 0 eq
   {
    ZE 1 add /ZE exch def
   }
   {
    exit
   }ifelse 
  }for
  ZE 0 ne
  {  %% hi ha zeros a l'esquerra
   ZE finS eq
   {  %% l'enter és un zero
    0 get 0 2 array astore  %% refem l'array d'enters sense zeros a l'esquerra
   }
   {  %% l'enter NO és un zero
    mark exch dup 0 get exch 1 ZE add finS ZE sub getinterval aload pop ]  %% refem l'array d'enters sense zeros a l'esquerra
  }ifelse
  }if
 }if

%%Aa
 Aa
 {  %% string: fragmentem la part decimal
  exch mark exch
  {  %% forall per fragmentar dígit a dígit
   dgt exch 0 exch put dgt cvx exec
  }forall
 }
 {  %% array: desempaquetem la part decimal
  exch 1 get mark exch aload pop
 }ifelse

 counttomark dup /dcmls exch def 1 gt  %% sobren zeros a la dreta dels decimals?
 {  %% esporguem zeros a la dreta a l'array decimal
  /ndcmls 0 def
  {  %% loop
   dup 0 eq
   {
    pop
    ndcmls 1 add /ndcmls exch def
   }
   {
    exit
   }ifelse
  }loop
  dcmls ndcmls eq
  {  %% com que tot eren zeros, en deixem només un a l'array
   0
  }if
 }if

 %% necessitem igualar els dígits, farcint amb zeros, dels enters (esquerra) i decimals (dreta) dels dos nombres a computar
 %% farcim de zeros a la dreta igualant els dígits decimals a 2nmbr? (segon nombre)
 counttomark 1nmbr 1 get length sub dup 0 lt
 {
  abs {0}repeat  %% farcim de zeros a la dreta igualant decimals a 2nmbr
  /iglr_1nmbr false def
 }
 {
  pop
  /iglr_1nmbr true def  %% és al primer nombre (1nmbr) on haurem de farcir de zeros a la dreta igualant decimals
 }ifelse
 ]  %% tanquem l'array decimal
 2 array astore /2nmbr exch def  %% desem el paquet amb el segon nombre fragmentat (sumand o subtrahend)

 %% hem de farcir de zeros a l'esquerra als enters de 1nmbr o 2nmbr?
 dup 0 get length  %% enters+signe de 1nmbr
 2nmbr 0 get length  %% enters+signe de 2nmbr
 sub dup 0 lt
 {  %% és al 1nmbr on hem de farcir els enters
  dup 0 eq
  {  %% no fem re
   pop
  }
  {  %% és al 1nmbr on hem de farcir els enters
   abs dup dup 1 add /araVa exch def 2 index 0 get length add array dup  %% nou paquet d'enters
   3 index 0 get 0 get 0 exch put  %% farcim el signe
   exch 1 exch 1 exch
   {  %% for per farcir de zeros a l'esquerra dels enters, després del signe
    1 index exch 0 put
   }for
   dup 2 index 0 get dup length 1 sub 1 exch getinterval araVa exch putinterval
   1 index exch 0 exch put  %% modifiquem l'array d'enters 1nmbr a l'stack
  }ifelse
 }
 {  %% és al 2nmbr on hem de farcir els enters
  dup dup 1 add /araVa exch def 2nmbr 0 get length add array dup  %% nou paquet d'enters
  2nmbr 0 get 0 get 0 exch put  %% farcim el signe
  exch 1 exch 1 exch
  {  %% for per farcir de zeros a l'esquerra dels enters, després del signe
   1 index exch 0 put
  }for
  dup 2nmbr 0 get dup length 1 sub 1 exch getinterval araVa exch putinterval
  2nmbr exch 0 exch put  %% desem l'array d'enters a 2nmbr
 }ifelse

 iglr_1nmbr  %% igualem i farcim de zeros a la dreta decimals a 1nmbr?
 {
  dup 1 get length 2nmbr 1 get length ne
  {
   dup dup 1 get 2nmbr 1 get length exch length sub /0f exch def  %% nombre de zeros a farcir
   1 get mark exch aload pop 0f {0}repeat ] 1 exch put  %% farcim a la dreta, tanquem i ho desem a lloc
  }
  {
   pop
  }ifelse
 }
 {
  pop
 }ifelse

 %% primer ens cal saber quin dels dos nombres és el més gran sense signe (absolut)
 %% 1abs = true = el més gran es 1nmbr / 1abs = false = el més gran és 2nmbr
 %% comparem enters
 /gls true def  %% són iguals?
 1 1 1nmbr 0 get length 1 sub
 {  %% for
  dup 1nmbr 0 get exch get
  exch 2nmbr 0 get exch get
  2 copy eq
  {
   pop pop
  }
  {
   /gls false def  %% NO són iguals
   gt /1abs exch def  %% flag de si és més gran 1nmbr (true) o 2nmbr (false)
   exit
  }ifelse
 }for
 %% només si els enters són iguals comparem decimals
 gls
 {
  /gls true def  %% són iguals?
  0 1 1nmbr 1 get length 1 sub
  {
   dup 1nmbr 1 get exch get
   exch 2nmbr 1 get exch get
   2 copy eq
   {
    pop pop
   }
   {
    /gls false def  %% NO són iguals
    gt /1abs exch def  %% flag de si és més gran 1nmbr (true) o 2nmbr (false)
    exit
   }ifelse
  }for
 }if

 %% computem la suma
 %% avaluem el signe dels dos sumands:
 1nmbr 0 get 0 get  %% signe del primer sumand
 2nmbr 0 get 0 get  %% signe del segon sumand
 2 copy and  %% si els dos són negatius, el resultat rsltt serà negatiu
 {
  pop pop true
  /zero false def  %% rsltt serà zero?
  /smorst true def  %% sumem decimals i enters
 }
 {
  or
  {  %% si un dels dos és negatiu, el nombre més gran absolut decidirà el signe, però si són iguals rsltt serà zero
   gls
   {
    /zero true def  %% rsltt serà zero?
   }
   {
    1abs  %% signe del rsltt
    {
     1nmbr 0 get 0 get
    }
    {
     2nmbr 0 get 0 get
    }ifelse 
    /zero false def  %% rsltt serà zero?
    /smorst false def  %% restem decimals i enters
   }ifelse
  }
  {  %% si tots dos són positius el resultat rsltt serà positiu
   false  %% signe del rsltt
   /zero false def  %% rsltt serà zero?
   /smorst true def  %% sumem decimals i enters
  }ifelse 
 }ifelse
 
 zero  %% rsltt serà zero?
 {
  [ [false 0][0] ] /rsltt exch def
 }
 {  %% sumem o restem, decimals i enters, en funció de smorst
  mark  %% contenidor dels decimals
  smorst
  {  %% sumem
%%SUMADORd'arrays
   /enprtm 0 def  %% en portem per sumar al següent
   %% primer els decimals
   1nmbr 1 get length 1 sub -1 0
   {  %% for enrera
    dup 1nmbr 1 get exch get enprtm add exch
    2nmbr 1 get exch get add
    dup 10 ge
    {
     10 sub  %% dígit resolt
     /enprtm 1 def  %% en portem per sumar al següent
    }
    {
     /enprtm 0 def  %% en portem per sumar al següent
    }ifelse
   }for

   %% ordena capgirant els elements fins a mark
   counttomark 1 sub /cpgrm 2 def
   {
    cpgrm -1 roll cpgrm 1 add /cpgrm exch def
   }repeat
%%SUMADORd'arrays

   ] exch mark exch  %% tanquem el contenidor de decimals i anem pels enters
   1nmbr 0 get length 1 sub -1 1
   {  %% for enrera
    dup 1nmbr 0 get exch get enprtm add exch
    2nmbr 0 get exch get add
    dup 10 ge
    {
     10 sub  %% dígit resolt
     /enprtm 1 def  %% en portem per sumar al següent
    }
    {
     /enprtm 0 def  %% en portem per sumar al següent
    }ifelse
   }for
   enprtm  %% darrer digit enter resultant
   %% ordena capgirant els elements fins a mark
   counttomark 1 sub /cpgrm 2 def
   {
    cpgrm -1 roll cpgrm 1 add /cpgrm exch def
   }repeat
   cpgrm 1 sub 1 roll  %% posem el flag del signe al davant de tot
   ] exch  %% tanquem el contenidor d'enters
   2 array astore /rsltt exch def  %% resultat final
   %% (+hem de sumar)==
  }
  {  %% restem
   /enprtm 0 def  %% en portem per sumar al següent
   %% primer els decimals
   1nmbr 1 get length 1 sub -1 0
   {  %% for enrera
    dup 1nmbr 1 get exch get exch
    2nmbr 1 get exch get
 
    1abs not  %% true: és més gran 1nmbr (no invertim els valors)
    { %% false: és més gran 2nmbr (invertim els valors, ara és 1nmbr el subtrahend)
     exch
    }if
    enprtm add  %% és al subtrahend al qui sumem quantes en portem
 
    2 copy lt
    {  %% si el minuend és més petit que el subtrahend
     exch 10 add exch  %% li sumem 10
     /enprtm 1 def  %% en portem per sumar al següent
    }
    {
     /enprtm 0 def  %% en portem per sumar al següent
    }ifelse
    sub
   }for
   %% ordena capgirant els elements fins a mark
   counttomark 1 sub /cpgrm 2 def
   {
    cpgrm -1 roll cpgrm 1 add /cpgrm exch def
   }repeat
   ] exch mark exch  %% tanquem el contenidor de decimals i anem pels enters
   1nmbr 0 get length 1 sub -1 1
   {  %% for enrera
    dup 1nmbr 0 get exch get exch
    2nmbr 0 get exch get
 
    1abs not  %% true: és més gran 1nmbr (no invertim els valors)
    { %% false: és més gran 2nmbr (invertim els valors, ara és 1nmbr el subtrahend)
     exch
    }if
    enprtm add  %% és al subtrahend al qui sumem quantes en portem
 
    2 copy lt
    {  %% si el minuend és més petit que el subtrahend
     exch 10 add exch  %% li sumem 10
     /enprtm 1 def  %% en portem per sumar al següent
    }
    {
     /enprtm 0 def  %% en portem per sumar al següent
    }ifelse
    sub
   }for
   %% ordena capgirant els elements fins a mark
   counttomark 1 sub /cpgrm 2 def
   {
    cpgrm -1 roll cpgrm 1 add /cpgrm exch def
   }repeat
   cpgrm 1 sub 1 roll  %% posem el flag del signe al davant de tot
   ] exch  %% tanquem el contenidor d'enters
   2 array astore /rsltt exch def  %% resultat final
   %% (+hem de restar)==
  }ifelse
 }ifelse

%%Aa
 dona
 {  %% resultat com a string
  %% passem el resultat d'array [[signe #enters][#decimals]] a string (#.#)
  rsltt 0 get dup /Aenters exch def dup 0 get
  {  %% signe negatiu
   /rSigne true def
  }
  {  %% signe positiu
   /rSigne false def
  }ifelse
  length rsltt 1 get dup /Adecimals exch def length add rSigne {1 add}if string /Srsltt exch def
  rSigne
  {  %% afegim el signe negatiu si s'escau
   Srsltt 0 (-) putinterval
  }if
  rSigne
  {
   Aenters length  %% índex on anirà el punt decimal
  }
  {
   Aenters length 1 sub  %% índex on anirà el punt decimal
  }ifelse
  /puntD exch def  %% índex on anirà el punt decimal
  1 1 Aenters length 1 sub
  {  %% passem a string tots els dígits enters menys el signe
   dup rSigne not{1 sub exch}if Aenters exch get 1 string cvs Srsltt 3 1 roll putinterval
  }for
  Srsltt puntD (.) putinterval  %% el punt decimal
  0 1 Adecimals length 1 sub
  {  %% passem a string tots els dígits decimals
   dup puntD add 1 add exch Adecimals exch get 1 string cvs Srsltt 3 1 roll putinterval
  }for
  %% deixem a l'stack el resultat /rsltt a string
  Srsltt
 }
 {  %% resultat com array
  rsltt
 }ifelse

}bind def

%[[false 1][0]] [[true 0 0 0 1 1][0 0 1 0 0 0 0]]
%false  %% d'entrada: llegim de l'stack arrays (false) / strings (true)
%false  %% de sortida: deixem a l'stack strings (true) / arrays (false)

%(1.0) (-00011.0010000)
%true  %% d'entrada: llegim de l'stack arrays (false) / strings (true)
%true  %% de sortida: deixem a l'stack strings (true) / arrays (false)

%Aacurat_add (&)pstack

